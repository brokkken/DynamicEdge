<UserControl x:Class="DynamicEdge.Views.EqBars"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="22" Height="16" VerticalAlignment="Center">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
    <Rectangle x:Name="B1" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
    <Rectangle x:Name="B2" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
    <Rectangle x:Name="B3" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
    <Rectangle x:Name="B4" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
  </StackPanel>
</UserControl>
