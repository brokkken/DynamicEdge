<Window x:Class="DynamicEdge.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="Добро пожаловать" Width="520" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI">
  <Grid Margin="32,28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <Border Width="150" Height="40" CornerRadius="20" Background="Black" HorizontalAlignment="Left" Margin="0,0,0,18" x:Name="DemoPill">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="#FF4CC2FF" Margin="0,0,8,0"/>
          <TextBlock Text="Dynamic Edge" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
        </StackPanel>
      </Border>
      <TextBlock Text="Добро пожаловать в Dynamic Edge" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="Умная капсула в верхней части экрана — как Dynamic Island, но для Windows 11." Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,22,0,0">
      <TextBlock Text="🎵  Музыка, обложки и управление плеером" Margin="0,0,0,8"/>
      <TextBlock Text="🔔  Уведомления Windows (в MSIX-версии)" Margin="0,0,0,8"/>
      <TextBlock Text="🔋  Заряд батареи, громкость, микрофон" Margin="0,0,0,8"/>
      <TextBlock Text="📋  Буфер обмена, таймер и секундомер" Margin="0,0,0,8"/>
      <TextBlock Text="📊  CPU, RAM и температура" Margin="0,0,0,18"/>
      <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12">
        Клик по капсуле — развернуть, повторный клик — свернуть. Ctrl+Alt+D — развернуть с клавиатуры.
        Иконка в системном трее открывает настройки и позволяет закрыть приложение.
      </TextBlock>
      <CheckBox x:Name="AutoBox" Content="Запускать Dynamic Edge вместе с Windows" IsChecked="True" Margin="0,18,0,0"/>
    </StackPanel>
    <Button Grid.Row="2" Content="Начать" HorizontalAlignment="Right" Padding="28,8" Click="Start_Click" IsDefault="True"/>
  </Grid>
</Window>
